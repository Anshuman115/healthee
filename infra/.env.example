# Healthee infra env — copy to infra/.env and fill in. .env is gitignored.
# Consumed by docker-compose.prod.yml, deploy.sh, and backup/pg_dump_backup.sh.
# Generate tokens: openssl rand -base64 48 | tr -d '/+=' | head -c 32

# ─── Postgres / TimescaleDB ──────────────────────────────────────────────
# POSTGRES_HOST is 'db' for the compose stack (service name on the network).
# POSTGRES_USER/PASSWORD are the OWNER/ADMIN identity: they create the DB, own
# the tables, and run migrations / claim_sentinel / provision_app_role. They are
# NOT what the app connects as — see POSTGRES_APP_* below.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=healthee
POSTGRES_USER=healthee
POSTGRES_PASSWORD=change-me-please

# ─── Postgres application role (least privilege, MULTI_USER.md §3.3) ─────
# The role the api/scheduler pool connects as: DML on the data tables only —
# no TRUNCATE, no DDL, NOSUPERUSER, NOBYPASSRLS. It exists because a SUPERUSER
# bypasses Row-Level Security unconditionally, which would make §3.3's policies
# test green and protect nothing.
#
# Blank ⇒ the app falls back to the admin creds above and logs a WARNING at
# startup saying RLS cannot apply to it. That fallback is a transitional state,
# not a configuration.
#
# ⚠ DEPLOY ORDER (this is a PROD CREDENTIAL CHANGE — wrong order = outage):
#   1. deploy the code (the fallback keeps the running app alive);
#   2. provision the role AS THE ADMIN, with the password in the environment:
#        POSTGRES_APP_USER=healthee_app POSTGRES_APP_PASSWORD='<secret>' \
#          docker compose --env-file infra/.env -f infra/docker/docker-compose.prod.yml \
#          exec api python -m healthee.db.provision_app_role
#   3. set both vars HERE, then restart api + scheduler (infra/deploy.sh);
#   4. confirm the startup log says "connected as least-privilege role".
# Setting these BEFORE step 2 means the app cannot authenticate at all.
# Generate: openssl rand -base64 48 | tr -d '/+=' | head -c 32
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# ─── API auth (required) ─────────────────────────────────────────────────
# Bearer token expected on every /ingest/* and /api/* request (mobile app).
REALTIME_INGEST_TOKEN=change-me-please

# ─── FastAPI bind (inside the container) ─────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8765

# ─── Logging ─────────────────────────────────────────────────────────────
# Python level name: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ─── Supabase identity (MULTI_USER.md §4) ────────────────────────────────
# The API only VERIFIES the access JWT Supabase issues; it never mints one.
# Blank secret ⇒ every JWT is refused (fails closed).
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Blank project ref ⇒ the `iss` check is skipped (dev / self-signed tokens).
SUPABASE_PROJECT_REF=
SUPABASE_JWT_AUD=authenticated

# ─── Signup gating (MULTI_USER.md §4, §13 [D1]) ──────────────────────────
# Enforced by the SERVER (§12.7), gating the creation of NEW accounts only —
# an owner who already has a row always gets in. Uncontrolled signup is
# uncontrolled LLM spend (every active owner gets a nightly chain).
#   SIGNUPS_OPEN=false + empty allowlist ⇒ nobody new (the default).
# Comma-separated, case-insensitive. To onboard the owner: put their email
# here, have them sign in once, then run db.claim_sentinel (§8).
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=

# ─── OpenRouter (optional — grounded LLM insights) ───────────────────────
# The key AND the model ids are kept OUT of git — set the real ids here.
# REQUIRED whenever OPENROUTER_API_KEY is set: a blank model id is sent to the
# API verbatim and comes back a 400. default_model = the cheap high-volume tier
# (recs/briefing/notable/insight cards); coach_model = the stronger interactive
# tier. Compare candidates with `scripts/model_eval.py <model-a> <model-b>`.
OPENROUTER_API_KEY=
DEFAULT_MODEL=<provider>/<cheap-model-id>
COACH_MODEL=<provider>/<stronger-model-id>

# ─── Telegram notifications (optional) ───────────────────────────────────
# Job results + failures are reported here when set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Deployment (deploy.sh) ──────────────────────────────────────────────
# Branch the VPS deploys from; deploy.sh aborts if local != origin/<branch>.
DEPLOY_BRANCH=main

# ─── Backups (backup/pg_dump_backup.sh) ──────────────────────────────────
# Where dated .sql.gz dumps are written, and how many days to keep.
BACKUP_DIR=/var/backups/healthee
BACKUP_RETENTION_DAYS=30
# Optional off-box copy: a command run with the dump path as $1 (scp/rclone).
# Example: OFFBOX_CMD="rclone copy {} remote:healthee-backups"
# The literal {} is replaced with the dump file path. Leave blank to skip.
OFFBOX_CMD=
