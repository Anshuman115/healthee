# Healthee infra env — copy to infra/.env and fill in. .env is gitignored.
# Consumed by docker-compose.prod.yml, deploy.sh, and backup/pg_dump_backup.sh.
# Generate tokens: openssl rand -base64 48 | tr -d '/+=' | head -c 32

# ─── Postgres / TimescaleDB ──────────────────────────────────────────────
# POSTGRES_HOST is 'db' for the compose stack (service name on the network).
# POSTGRES_USER/PASSWORD are the OWNER/ADMIN identity: they create the DB, own
# the tables, and run migrations / claim_sentinel / provision_app_role. They are
# NOT what the app connects as — see POSTGRES_APP_* below.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=healthee
POSTGRES_USER=healthee
POSTGRES_PASSWORD=change-me-please

# ─── Postgres application role (least privilege, MULTI_USER.md §3.3) ─────
# The role the api/scheduler pool connects as: DML on the data tables only —
# no TRUNCATE, no DDL, NOSUPERUSER, NOBYPASSRLS. It exists because a SUPERUSER
# bypasses Row-Level Security unconditionally, which would make §3.3's policies
# test green and protect nothing.
#
# Blank ⇒ the app falls back to the admin creds above and logs a WARNING at
# startup saying RLS cannot apply to it. That fallback is a transitional state,
# not a configuration.
#
# ⚠ DEPLOY ORDER (this is a PROD CREDENTIAL CHANGE — wrong order = outage).
# `infra/deploy.sh` now provisions the role itself on every run, but ONLY once both
# vars below are set — which is the same pair the app pool reads. So the bootstrap is
# inherently TWO deploys, and that is the deliberate path:
#   1. deploy with these two UNSET — the app falls back to the admin creds and stays
#      alive; the startup log warns that RLS is isolating nothing;
#   2. set BOTH vars here, then deploy again — deploy.sh provisions the role (as the
#      admin) BEFORE recreating the app, so it exists by the time the app needs it;
#   3. confirm the startup log says "connected as least-privilege role".
# Setting these while the role does not yet exist means the app cannot authenticate to
# Postgres at all. Full procedure + the why: infra/DEPLOY.md § "The credential ORDER".
# Generate: openssl rand -base64 48 | tr -d '/+=' | head -c 32
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# ─── API auth (required) ─────────────────────────────────────────────────
# Bearer token expected on every /ingest/* and /api/* request (mobile app).
REALTIME_INGEST_TOKEN=change-me-please

# ─── FastAPI bind (inside the container) ─────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8765

# ─── Logging ─────────────────────────────────────────────────────────────
# Python level name: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ─── Supabase identity (MULTI_USER.md §4) ────────────────────────────────
# The API only VERIFIES the access JWT Supabase issues; it never mints one.
# Blank secret ⇒ every JWT is refused (fails closed).
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Blank project ref ⇒ the `iss` check is skipped (dev / self-signed tokens).
SUPABASE_PROJECT_REF=
SUPABASE_JWT_AUD=authenticated

# ─── Signup gating (MULTI_USER.md §4, §13 [D1]) ──────────────────────────
# Enforced by the SERVER (§12.7), gating the creation of NEW accounts only —
# an owner who already has a row always gets in. Uncontrolled signup is
# uncontrolled LLM spend (every active owner gets a nightly chain).
#   SIGNUPS_OPEN=false + empty allowlist ⇒ nobody new (the default).
# Comma-separated, case-insensitive. To onboard the owner: put their email
# here, have them sign in once, then run db.claim_sentinel (§8).
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=

# ─── Entitlement (MULTI_USER.md §12, Phase 6.6a) ─────────────────────────
# The AI layer is premium; the tracker is free. Entitlement lives in the
# `subscription` table and is granted with `python -m healthee.db.grant_premium`
# — NOT here. This flag is the one deployment-wide override: set it true only
# on a SELF-HOSTED box, where the LLM bill is the operator's own. On the hosted
# service it must stay false, and the API/scheduler log a warning on every boot
# if it is not. It must reach the SCHEDULER too, or a self-hosted install's
# nightly chain skips the AI steps it just paid for.
SELF_HOST_UNLOCKED=false
# Where a locked card sends someone. Blank until [D4] picks a provider; the
# 402 body and /api/entitlement carry it verbatim.
UPGRADE_URL=

# ─── OpenRouter (optional — grounded LLM insights) ───────────────────────
# The key AND the model ids are kept OUT of git — set the real ids here.
# REQUIRED whenever OPENROUTER_API_KEY is set: a blank model id is sent to the
# API verbatim and comes back a 400. default_model = the cheap high-volume tier
# (recs/briefing/notable/insight cards); coach_model = the stronger interactive
# tier. Compare candidates with `scripts/model_eval.py <model-a> <model-b>`.
# ⚠ The api and scheduler REFUSE TO START with the key set and either id blank —
# that combination is a dead AI layer behind a green /healthz, which is what
# prod actually ran. Leave ALL THREE blank to deploy without the AI layer.
OPENROUTER_API_KEY=
DEFAULT_MODEL=<provider>/<cheap-model-id>
COACH_MODEL=<provider>/<stronger-model-id>
# Bound on ONE LLM call (seconds) and how many times the SDK retries it. Do not
# leave these blank-by-omission: unset, the openai SDK uses a 600 s read timeout
# and 2 retries = 30 minutes of hang for a single stuck call, and the scheduler is
# a single-threaded tick loop — that one call blocks every later owner's chain.
# Worst case here is LLM_MAX_RETRIES+1 × LLM_TIMEOUT_S. Raise the timeout only if
# you switch DEFAULT_MODEL to a slow reasoning tier.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# Dollars remaining on the OpenRouter account below which the scheduler WARNS to
# Telegram (once, on the way in and out — jobs/llm_watch.py). It is only a warning:
# nothing declines to spend because of it. Prod once hit its account ceiling and
# every LLM call 402'd for hours behind a green /healthz; this is the alert that
# fires BEFORE that, and `GET /readyz` is the pull surface for the same facts.
# Set it to a few days of YOUR spend. 0 disables the warning and leaves only the
# "exhausted" alert, which fires when it is already too late.
LLM_LOW_BALANCE_USD=20
# How many NUDGED REWRITES one generated answer gets before the honest fallback
# ships. Only a candidate that ALREADY failed its gates spends one, and the budget
# is reserved on top of the coach's tool-gathering allowance, never taken from it.
# 2 (three attempts) because the failures a nudge repairs are citation/format
# wording — turn it down if you point DEFAULT_MODEL/COACH_MODEL at an expensive
# tier. 0 means one attempt then the fallback; no value lets unvalidated text ship.
LLM_VALIDATION_RETRIES=2

# ─── Telegram notifications (optional) ───────────────────────────────────
# Job results + failures are reported here when set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Deployment (deploy.sh) ──────────────────────────────────────────────
# Branch the VPS deploys from; deploy.sh aborts if local != origin/<branch>.
DEPLOY_BRANCH=main

# ─── Backups (backup/pg_dump_backup.sh) ──────────────────────────────────
# Where dated .sql.gz dumps are written, and how many days to keep.
BACKUP_DIR=/var/backups/healthee
BACKUP_RETENTION_DAYS=30
# Optional off-box copy: a command run with the dump path as $1 (scp/rclone).
# Example: OFFBOX_CMD="rclone copy {} remote:healthee-backups"
# The literal {} is replaced with the dump file path. Leave blank to skip.
OFFBOX_CMD=
