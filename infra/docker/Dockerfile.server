# Healthee server image — uv-based, two-layer for cache friendliness.
# Adapted from the proven legacy Dockerfile; points at apps/server.
#
# Build context is the REPO ROOT (see docker-compose.prod.yml `context: ../..`)
# so the deps layer can copy apps/server/{pyproject.toml,uv.lock}.
#
# Tag pins Python 3.13 (the runtime-reproducibility axis) and tracks the latest
# uv, which is backward-compatible with the lockfile it reads. To pin uv too,
# switch to a published version tag once one matching the lock's revision exists
# (e.g. ghcr.io/astral-sh/uv:0.11.x-python3.13-bookworm-slim). BuildKit required
# (the cache mounts below) — enabled by default on modern Docker.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

# ── Layer 1: dependencies only ──────────────────────────────────────────
# Invalidated only when pyproject.toml or uv.lock changes — keeps rebuilds fast.
COPY apps/server/pyproject.toml apps/server/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# ── Layer 2: application code ───────────────────────────────────────────
COPY apps/server/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ── Knowledge corpus ────────────────────────────────────────────────────
# The grounded LLM layer reads the manifest + note bodies from here. Resolved
# via HEALTHEE_KNOWLEDGE_DIR (core/knowledge.py) — NOT a parents[n] offset,
# which only works in the dev tree.
COPY packages/knowledge ./packages/knowledge
ENV HEALTHEE_KNOWLEDGE_DIR=/app/packages/knowledge

ENV PATH="/opt/venv/bin:$PATH"

EXPOSE 8765

# uvicorn, single worker (single-tenant for now). Binds all interfaces in the
# container; the host publishes 127.0.0.1:8765 only — nginx is the sole caller.
# NOTE: healthee.api.app:app is created in Phase 1; this image builds now and
# runs once that module lands.
CMD ["uvicorn", "healthee.api.app:app", \
     "--host", "0.0.0.0", "--port", "8765", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
