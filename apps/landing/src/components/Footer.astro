---
const year = new Date().getFullYear();
const nav = [
  { href: '#coach', label: 'The coach' },
  { href: '#pipeline', label: 'The pipeline' },
  { href: '#guardrail', label: 'Cited is not enough' },
  { href: '#science', label: 'Science' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#self-host', label: 'Self-host' },
];
---

<footer class="border-t border-line py-14">
  <div class="shell">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span aria-hidden="true" class="grid h-7 w-7 place-items-center rounded-[7px] bg-accent">
            <svg viewBox="0 0 32 32" class="h-4 w-4" fill="none" aria-hidden="true">
              <path d="M10 11h12M10 16h12M10 21h7" stroke="var(--c-accent-ink)" stroke-width="2"
                stroke-linecap="round"></path>
              <circle cx="23.5" cy="21" r="1.7" fill="var(--c-accent-ink)"></circle>
            </svg>
          </span>
          <span class="font-serif text-lg tracking-tight">Healthee</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink-soft">
          An honest, self-hosted health companion. Grounded in graded research; it never flatters.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-ink-soft">
        {
          nav.map((l) => (
            <a href={l.href} class="transition-colors hover:text-ink">
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <hr class="hairline my-10" />

    <div class="flex flex-col gap-3 text-xs text-ink-faint md:flex-row md:items-center md:justify-between">
      <p class="mono">
        &copy; {year} Healthee &middot; a personal, self-hosted project &middot; not a medical device
      </p>
      <p class="mono">No trackers. No analytics. No third-party scripts on this page.</p>
    </div>
  </div>
</footer>
