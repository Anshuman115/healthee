---
import Section from './Section.astro';
// Plain-words version of the honesty calibration: the shakier the science, the
// softer it's allowed to speak. No grade names, no note ids — just the behaviour.
const grades = [
  {
    name: 'When it’s settled',
    tone: 'said plainly',
    eg: 'Being more active goes with living longer — that one really isn’t in doubt.',
  },
  {
    name: 'When it’s likely',
    tone: 'with a light “probably”',
    eg: 'How steady your heart is overnight is a good read on recovery — useful, but best taken as a trend, not a verdict.',
  },
  {
    name: 'When it’s still early',
    tone: 'flagged as early days',
    eg: 'A dip in your overnight skin temperature may be an early sign you’re coming down with something — but that science is young.',
  },
  {
    name: 'When it’s debated',
    tone: 'shown as an open question',
    eg: 'Whether any single “sleep score” really means much is honestly still argued over.',
  },
  {
    name: 'When it’s a myth',
    tone: 'gently corrected',
    eg: '“You can train yourself to get by on five hours.” Not really — how much sleep you need is mostly fixed.',
  },
];
---

<Section id="grades" labelledby="grades-h">
  <h2 id="grades-h" class="rise mt-4 max-w-2xl text-[clamp(1.9rem,4vw,3rem)]">
    The more certain the science, the more plainly it speaks.
  </h2>
  <p class="lede rise mt-6 max-w-2xl">
    It won’t dress up a shaky finding as settled fact. How sure it sounds always matches how strong
    the evidence really is — and when the science is mixed, it just tells you that.
  </p>

  <div class="rise mt-10 max-w-3xl">
    {
      grades.map((g) => (
        <div class="grade-row">
          <div>
            <span class="grade-name">{g.name}</span>
            <span class="grade-tone">{g.tone}</span>
          </div>
          <p class="grade-eg">{g.eg}</p>
        </div>
      ))
    }
  </div>

  <p class="mono rise mt-6 max-w-2xl text-xs leading-relaxed text-ink-faint">
    The rule is simple: the shakier the science, the softer it’s allowed to put it. It never sounds
    more sure than the evidence lets it.
  </p>
</Section>
