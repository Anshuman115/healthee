---
import Section from './Section.astro';
// Two ways to run it + the data-custody promise, in v4's plain forms. Honesty:
// the app is Phase 2, so the hosted plan "opens with the app" — no sign-up now,
// matching the status ribbon. Every promise is limited to what the repo does
// (README + docs/MULTI_USER.md §3.3): per-account isolation, Supabase-owned
// passwords, internet-closed DB + encrypted transit, nightly off-box backups.
// No encryption-at-rest / audit / compliance claims.
const promise = [
  {
    t: 'Kept separate from everyone else’s',
    d: 'Your data is never mixed in with anyone else’s — the system holds that line itself, even if our code slips up.',
  },
  {
    t: 'We never see your password',
    d: 'Signing in is handled somewhere safe, away from your health data. Your password never reaches us, and we never store it.',
  },
  {
    t: 'Never open to the internet',
    d: 'The database sits behind the wall, reachable only by the app itself — and everything travelling between them is scrambled so no one can read it on the way.',
  },
  {
    t: 'Backed up every night',
    d: 'A copy is saved off the machine each night, so a lost computer never means lost data.',
  },
  {
    t: 'Never sold, no trackers',
    d: 'We never sell your data. And there are no trackers on this page — not even to count visitors.',
  },
];
---

<Section id="self-host" tone="sunk" labelledby="selfhost-h">
  <h2 id="selfhost-h" class="rise mt-4 max-w-2xl text-[clamp(1.9rem,4vw,3rem)]">
    You run it yourself, or we run it for you.
  </h2>
  <p class="lede rise mt-6 max-w-2xl">
    The engine is built, running, and keeps every person’s data separate. You can run the whole thing
    yourself today — or wait for the simple version that arrives with the app.
  </p>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <!-- self-host -->
    <div class="surface rise flex flex-col p-7 sm:p-8">
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-2xl font-semibold tracking-tight">You run it yourself</h3>
        <span class="chip chip-accent chip-dot">free, yours forever</span>
      </div>
      <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-soft">
        Your computer, your data — nothing ever leaves your box. It runs on one small server, and the
        whole thing is yours to change.
      </p>
      <ul class="mt-5 space-y-2.5 text-[0.92rem] text-ink-soft">
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> Runs on one small computer you control</li>
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> Your data never leaves it</li>
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> Backed up off the box every night, in one command</li>
      </ul>
      <p class="mono mt-6 text-xs text-ink-faint">For the technically inclined.</p>
    </div>

    <!-- hosted -->
    <div class="surface rise flex flex-col p-7 sm:p-8">
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-2xl font-semibold tracking-tight">We run it for you</h3>
        <span class="chip chip-dot">opens with the app</span>
      </div>
      <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-soft">
        Don’t want to run a server? We’ll run the same code for you — the same honesty, none of the
        setup. Tracking stays free; you’d only pay for the coach, exactly as priced above.
      </p>
      <ul class="mt-5 space-y-2.5 text-[0.92rem] text-ink-soft">
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> Same app, same promises, zero setup</li>
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> You sign in; we handle the rest</li>
        <li class="flex gap-3"><span aria-hidden="true" class="mono shrink-0 text-accent-soft">✓</span> Your data still separate, still yours</li>
      </ul>
      <div class="mt-6 border-t border-line pt-4">
        <p class="text-sm leading-relaxed text-ink-soft">
          Sign-ups open when the app ships. Leave your email and we’ll tell you the moment they
          do — nothing else, no newsletter.
        </p>
        <form method="post" action="/api/waitlist" class="mt-3" data-waitlist>
          <div class="flex flex-wrap gap-2">
            <label class="sr-only" for="waitlist-email">Your email</label>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              maxlength="254"
              placeholder="you@example.com"
              autocomplete="email"
              class="min-w-0 flex-1 rounded-[6px] border border-line-strong bg-canvas px-3 py-2.5 text-[0.95rem] text-ink placeholder:text-ink-faint focus-visible:outline-2 focus-visible:outline-accent"
            />
            <button type="submit" class="btn btn-primary shrink-0">Join the waitlist</button>
          </div>
          {/* honeypot — humans never see it; bots that fill it get a polite no-op */}
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
          />
          <p class="mono mt-2 min-h-[1.2em] text-xs text-ink-faint" data-waitlist-msg aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>

  <!-- where the code lives -->
  <p class="rise mt-6 max-w-3xl text-[0.95rem] leading-relaxed text-ink-soft">
    The whole thing runs on one small computer you control. The code goes up on GitHub the moment
    it&rsquo;s ready to run yourself &mdash; and the link will appear right here.
    <span class="text-ink-faint">Still being built, out in the open. No link yet, no pretending
    otherwise.</span>
  </p>

  <!-- the custody promise -->
  <div class="rise mt-14 max-w-3xl">
    <h3 class="mt-4 text-[clamp(1.5rem,3vw,2.1rem)] font-semibold tracking-tight">
      Your numbers stay yours.
    </h3>
    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {
        promise.map((p) => (
          <div>
            <dt class="flex items-center gap-2.5 font-medium">
              <span aria-hidden="true" class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              {p.t}
            </dt>
            <dd class="mt-1.5 text-[0.92rem] leading-relaxed text-ink-soft">{p.d}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mono mt-8 text-xs leading-relaxed text-ink-faint">
      We only promise what the code actually does — no security badges or compliance stamps we
      haven’t earned. You can read the code and check for yourself.
    </p>
  </div>
</Section>

<script>
  // Progressive enhancement: without JS the form posts to /api/waitlist and the
  // Worker answers with a plain page; with JS we stay on the page and speak in
  // the product's voice. Same-origin call — the page still loads nothing external.
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  const msg = document.querySelector<HTMLElement>('[data-waitlist-msg]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const data = new FormData(form);
    msg.textContent = '…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: data.get('email'), website: data.get('website') }),
      });
      const out = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
      if (res.ok && out?.ok) {
        form.querySelector('input[name="email"]')?.setAttribute('disabled', '');
        form.querySelector('button')?.setAttribute('disabled', '');
        msg.textContent = 'You’re on the list. We’ll only write when it’s ready.';
      } else {
        msg.textContent = out?.error ?? 'That didn’t go through — try again in a minute.';
      }
    } catch {
      msg.textContent = 'That didn’t go through — try again in a minute.';
    }
  });
</script>
