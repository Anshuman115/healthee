---
import Section from './Section.astro';
// Tier split from PRICING.md §1a — lead with FREE, because "we don't paywall your
// own data" is the wedge. Prices from §0. Planned features stay marked planned.
// Competitor prices from §2, dated 2026-07, in v4's per-company plain form.
const free = [
  'Every number, chart & trend — with your full history',
  'Your own baselines, and a flag when something’s off for you',
  'Recovery score, live readiness & honest guidance',
  'Early warning if you might be getting sick (always free)',
  '“How sure it is” on every number',
  'Logging, workouts & GPS routes',
  'The research behind it — read it yourself',
  'Own your data — no lock-in',
  'Your personal patterns, shown as plain stats',
];
const premium = [
  'The honest coach — 20 questions every 30 days',
  'A daily action worth doing, every day',
  'Daily suggestions (1–3, backed or dropped)',
  'Insight cards — sleep · activity · workouts',
  'A feed of what changed',
  'The coach that explains your patterns and acts on them',
];
const planned = [
  'Challenges & programs — start, track, look back',
  'A coach that remembers, nudges & sets goals (later)',
];
// Prices from PRICING.md §0, DECIDED 2026-08-02. The lifetime plan was dropped there —
// $99 covers ~23 months of a per-question cost and then loses money forever — so it is
// not listed here either. Two plans, not three.
const plans = [
  { name: 'Monthly', price: '$6.99', unit: '/ month', note: 'Cancel anytime.', feature: false },
  { name: 'Yearly', price: '$69', unit: '/ year', note: '≈ $5.75 a month — two months free.', feature: true },
];
---

<Section id="pricing" labelledby="pricing-h">
  <h2 id="pricing-h" class="rise mt-4 max-w-2xl text-[clamp(1.9rem,4vw,3rem)]">
    The whole tracker is free. You pay only for the coach.
  </h2>
  <p class="lede rise mt-6 max-w-2xl">
    Free is all your numbers and the evidence behind them. The coach is the part that reads those
    numbers and talks to you about what to do. We never charge you to see your own data — and never
    for the safety warnings.
  </p>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <div class="surface rise p-7 sm:p-8">
      <div class="flex items-center justify-between">
        <h3 class="text-2xl font-semibold tracking-tight">Free, forever</h3>
        <span class="chip chip-accent chip-dot">the honest tracker</span>
      </div>
      <ul class="mt-6 space-y-3">
        {
          free.map((f) => (
            <li class="flex gap-3 text-[0.95rem] leading-relaxed">
              <span aria-hidden="true" class="mono mt-0.5 shrink-0 text-accent-soft">✓</span>
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="surface rise p-7 sm:p-8">
      <div class="flex items-center justify-between">
        <h3 class="text-2xl font-semibold tracking-tight">The coach</h3>
        <span class="chip chip-dot">optional</span>
      </div>
      <ul class="mt-6 space-y-3">
        {
          premium.map((p) => (
            <li class="flex gap-3 text-[0.95rem] leading-relaxed">
              <span aria-hidden="true" class="mono mt-0.5 shrink-0 text-accent-soft">✦</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      <hr class="hairline my-6" />
      <p class="eyebrow">Planned, not built yet</p>
      <ul class="mt-4 space-y-2.5">
        {
          planned.map((p) => (
            <li class="flex gap-3 text-sm leading-relaxed text-ink-faint">
              <span aria-hidden="true" class="mono mt-0.5 shrink-0">○</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="rise mt-8 text-[0.95rem] leading-relaxed text-ink-soft">
    Two plans, and one honest number attached to them:
  </p>
  <div class="mt-4 grid gap-6 sm:grid-cols-2">
    {
      plans.map((plan) => (
        <div class:list={['surface rise flex flex-col p-6', plan.feature && 'ring-1 ring-accent/60']}>
          <div class="flex items-center justify-between">
            <span class="font-medium">{plan.name}</span>
            {plan.feature && <span class="chip chip-accent">best value</span>}
          </div>
          <div class="mt-4 flex items-baseline gap-1.5">
            <span class="mono text-3xl tracking-tight">{plan.price}</span>
            <span class="mono text-sm text-ink-faint">{plan.unit}</span>
          </div>
          <p class="mt-3 text-sm text-ink-soft">{plan.note}</p>
        </div>
      ))
    }
  </div>
  <p class="rise mt-4 text-[0.95rem] leading-relaxed text-ink-soft">
    <strong class="font-medium text-ink">20 coach questions every 30 days</strong> — about one
    every day and a half. Everything else in the paid tier is unlimited: the daily action, the
    insight cards, the suggestions. We say the number instead of writing “unlimited” and quietly
    throttling you, because each question really does cost us money, and this product doesn’t do
    the quiet version of anything. When you run out, we tell you the day it comes back.
  </p>

  <div class="rise mt-12 border-t border-line pt-8">
    <p class="max-w-2xl text-[0.95rem] leading-relaxed text-ink-soft">
      For a sense of scale: <strong class="font-medium text-ink">Whoop</strong> charges $199 a year
      before you can see your own numbers at all, and <strong class="font-medium text-ink">Oura</strong>’s
      full insights cost $69.99 a year on top of a $349 ring. Our whole pitch is the opposite:
      <span class="text-ink">$69 a year versus Whoop’s $199</span>, on a band that doesn’t hold your
      numbers hostage — and every number stays free whether you subscribe or not.
    </p>
    <p class="mono mt-4 text-xs text-ink-faint">
      Whoop and Oura prices are from their own pages, current as of 2026-07 (links in Sources).
    </p>
  </div>
</Section>
