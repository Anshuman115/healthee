---
// The margin-rail section shell — the page's signature layout device.
// A §-numbered gutter (sticky on desktop, stacked on mobile) carries a mono
// margin annotation, like a lab notebook; the body slot holds the section
// content. Every numbered section on the page composes through this so the
// rhythm and the rail stay consistent (second occurrence = extract).
interface Props {
  n: string;
  id?: string;
  note?: string;
  tone?: 'paper' | 'sunk';
  labelledby?: string;
}
const { n, id, note, tone = 'paper', labelledby } = Astro.props;
---

<section
  id={id}
  class:list={['section scroll-mt-20', tone === 'sunk' && 'band-sunk']}
  aria-labelledby={labelledby}
>
  <div class="shell rail">
    <aside class="rail-aside rise">
      <span class="rail-num" aria-hidden="true">§&nbsp;{n}</span>
      {note && <p class="rail-note">{note}</p>}
    </aside>
    <div class="rail-body">
      <slot />
    </div>
  </div>
</section>
