---
// Sources — now just the two competitor prices we quote, each linked to the
// company's own page and dated. We describe only these two, only from their
// published pricing (docs/PRICING.md §2). Nothing else on the page needs a
// citation apparatus.
const pricing = [
  { key: 'Whoop', text: 'Membership tiers & pricing. Current as of 2026-07.', href: 'https://www.whoop.com/us/en/membership/', link: 'whoop.com/membership' },
  { key: 'Oura', text: 'Membership — $5.99 / month · $69.99 / year. Current as of 2026-07.', href: 'https://ouraring.com/membership', link: 'ouraring.com/membership' },
];
---

<section class="section border-t border-line" aria-labelledby="sources-h">
  <div class="shell">
    <div class="max-w-2xl">
      <p class="eyebrow rise">Sources</p>
      <h2 id="sources-h" class="rise mt-4 text-[clamp(1.7rem,3.5vw,2.5rem)]">
        Where the price comparisons come from.
      </h2>
      <p class="lede rise mt-6">
        We only name Whoop and Oura, and only their own published prices — checked on the dates below.
        No other numbers on this page are borrowed from anyone else.
      </p>
    </div>

    <div class="mt-10 max-w-2xl">
      <dl class="srclist rise">
        {
          pricing.map((r) => (
            <div class="srcitem">
              <dt class="srckey">{r.key}</dt>
              <dd>
                {r.text}{' '}
                <a class="link-underline" href={r.href} target="_blank" rel="noopener noreferrer nofollow">
                  {r.link}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
