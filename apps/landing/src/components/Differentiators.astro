---
import Section from './Section.astro';
// The three differentiators, in spirit from PRICING.md §1: free tracking for the
// life of the strap · honest-or-quiet · your data, your terms. Plain words only.
const points = [
  {
    n: '01',
    title: 'Tracking is free, for as long as you own the band',
    body: 'Every number, chart, and trend is free forever. We don’t sell the band, and we won’t charge you a subscription to see your own numbers. The band is yours — so are the readings it takes.',
    tag: 'no subscription for tracking',
  },
  {
    n: '02',
    title: 'If it can’t back something up, it stays quiet',
    body: 'Before it tells you what a number means, it checks the claim against real research you can read yourself. If it can’t back it up, it doesn’t soften it — it drops it.',
    tag: 'honest, or it says nothing',
  },
  {
    n: '03',
    title: 'Your data, on your terms',
    body: 'You can run the whole thing yourself on one small computer, with your history kept on your phone and backed up safely. Owning your data isn’t a slogan here — it’s how it’s built.',
    tag: 'run it yourself',
  },
];
---

<Section id="different" labelledby="different-h">
  <h2 id="different-h" class="rise mt-4 max-w-3xl text-[clamp(1.9rem,4vw,3rem)]">
    Every other health app cheers you on. This one tells you the truth.
  </h2>
  <p class="lede rise mt-6 max-w-2xl">
    Streaks, green rings, and praise you didn’t earn keep you tapping. Healthee is the friend who
    tells you the truth kindly — built on three things no one else does all at once.
  </p>

  <ol class="mt-12 grid gap-px overflow-hidden rounded-[6px] border border-line-strong bg-line md:grid-cols-3">
    {
      points.map((p) => (
        <li class="rise flex flex-col bg-canvas p-7">
          <span class="mono text-sm text-accent-soft">{p.n}</span>
          <h3 class="mt-5 text-xl leading-snug">{p.title}</h3>
          <p class="mt-4 grow text-[0.95rem] leading-relaxed text-ink-soft">{p.body}</p>
          <span class="chip chip-accent mt-6 self-start">{p.tag}</span>
        </li>
      ))
    }
  </ol>

  <p class="rise mt-8 max-w-2xl text-[0.95rem] leading-relaxed text-ink-faint">
    The big trackers have AI coaches too — but none of them show you where their advice comes from.
    The sections below show, rather than tell, why ours does.
  </p>
</Section>
