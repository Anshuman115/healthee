---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Differentiators from '../components/Differentiators.astro';
import HonestyShowcase from '../components/HonestyShowcase.astro';
import ScienceLayer from '../components/ScienceLayer.astro';
import PersonalScience from '../components/PersonalScience.astro';
import Pricing from '../components/Pricing.astro';
import SelfHost from '../components/SelfHost.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Footer from '../components/Footer.astro';

const title = 'Healthee — the health companion that refuses to flatter you';
const description =
  'An honest, self-hosted AI health companion. Every interpretation cited to graded research, every number carrying its confidence, and "not enough data" over a confident guess.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <Differentiators />
    <HonestyShowcase />
    <ScienceLayer />
    <PersonalScience />
    <Pricing />
    <SelfHost />
    <Disclaimer />
  </main>
  <Footer />
</Base>
