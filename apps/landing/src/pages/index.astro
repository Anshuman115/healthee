---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Differentiators from '../components/Differentiators.astro';
import CoachExchange from '../components/CoachExchange.astro';
import Pipeline from '../components/Pipeline.astro';
import GuardrailDemo from '../components/GuardrailDemo.astro';
import GradeScale from '../components/GradeScale.astro';
import MetricAnatomy from '../components/MetricAnatomy.astro';
import ScienceLayer from '../components/ScienceLayer.astro';
import PersonalScience from '../components/PersonalScience.astro';
import Pricing from '../components/Pricing.astro';
import SelfHost from '../components/SelfHost.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Sources from '../components/Sources.astro';
import Footer from '../components/Footer.astro';

const title = 'Healthee — the health companion that refuses to flatter you';
const description =
  'An honest, self-hosted companion app for the Amazfit Helio Strap. It reads what the strap records, tells you the truth backed by real research, and says “not enough data” instead of guessing. No green rings.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <Differentiators />
    <CoachExchange />
    <Pipeline />
    <GuardrailDemo />
    <GradeScale />
    <MetricAnatomy />
    <ScienceLayer />
    <PersonalScience />
    <Pricing />
    <SelfHost />
    <Disclaimer />
    <Sources />
  </main>
  <Footer />
</Base>
