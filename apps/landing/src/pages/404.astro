---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Page not found — Healthee';
const description = 'This page does not exist. Healthee tells you that plainly.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="moment" aria-labelledby="nf-title">
      <div class="wrap flex min-h-[52vh] flex-col items-start justify-center">
        <h1 id="nf-title" class="say-big">
          This page doesn&rsquo;t exist. We won&rsquo;t <span class="warm">pretend</span> it does.
        </h1>
        <p class="lede mt-6" style="max-width:34rem;">
          Same honesty as the rest of it: nothing here to show you. The real page is one click
          away.
        </p>
        <a href="/" class="btn btn-primary mt-9">Back to the page that exists</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
