---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Favicon: an honest-reading mark — a small rising line that stops short of the
// point it doesn't have yet (it won't claim what it can't see), on the warm clay
// accent. Inline SVG data-URI so the page loads zero external resources.
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23bf4d2b'/%3E%3Cpath d='M7 21l5-5 4 3 5-8' fill='none' stroke='%23fff8f3' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='25' cy='11' r='1.9' fill='%23fff8f3'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href={favicon} />
    {/* Seed theme + animation flag before paint so there is no flash of the wrong
        theme. LIGHT is the default; dark is opt-in only — we deliberately do NOT
        follow the OS preference, only a saved choice. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          if (localStorage.getItem('healthee-theme') === 'dark') root.classList.add('dark');
        } catch (e) {
          /* localStorage unavailable — stay on the light default */
        }
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('js-anim');
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-[color:var(--c-accent-ink)]"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Scroll-reveal: only elements marked .rise, only when the head script
      // enabled .js-anim (JS present + motion allowed). Otherwise untouched/visible.
      if (document.documentElement.classList.contains('js-anim')) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        for (const el of document.querySelectorAll('.rise')) observer.observe(el);
      }
    </script>
  </body>
</html>
