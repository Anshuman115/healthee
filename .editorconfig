# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{dart,yaml,yml,json,md}]
indent_size = 2

# Markdown: trailing whitespace is significant (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs.
[Makefile]
indent_style = tab

# Shell hooks/scripts use tabs (matches the committed style).
[.githooks/*]
indent_style = tab
